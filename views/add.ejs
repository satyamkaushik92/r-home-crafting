<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sell Land | r-home crafting</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-100 flex items-center justify-center min-h-screen p-4">

  <div class="bg-white p-6 md:p-8 rounded-2xl shadow-md w-full max-w-md border border-slate-200">
    <div class="mb-5 text-center">
      <h2 class="text-xl font-bold text-slate-900">List Plot for Sale</h2>
      <p class="text-xs text-slate-500 mt-1">Apne plot ya zameen ki details bharein</p>
    </div>
    
    <form action="/add" method="POST" enctype="multipart/form-data" class="space-y-4">
      <div>
        <label class="block text-xs font-semibold text-slate-700 mb-1">Property Title</label>
        <input 
          type="text" 
          name="title" 
          placeholder="e.g., Commercial Plot near Main Road" 
          required 
          class="w-full border border-slate-300 p-2.5 rounded-lg text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-amber-500"
        >
      </div>

      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Price (₹)</label>
          <input 
            type="number" 
            name="price" 
            placeholder="1500000" 
            required 
            class="w-full border border-slate-300 p-2.5 rounded-lg text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-amber-500"
          >
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Area / Size</label>
          <input 
            type="text" 
            name="size" 
            placeholder="1200 sqft / 2 kathha" 
            required 
            class="w-full border border-slate-300 p-2.5 rounded-lg text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-amber-500"
          >
        </div>
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-700 mb-1">Location</label>
        <input 
          type="text" 
          name="location" 
          placeholder="e.g., Phulwari Sharif, Patna" 
          required 
          class="w-full border border-slate-300 p-2.5 rounded-lg text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-amber-500"
        >
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-700 mb-1">WhatsApp Number (with country code)</label>
        <input 
          type="text" 
          name="whatsapp" 
          placeholder="91XXXXXXXXXX" 
          required 
          class="w-full border border-slate-300 p-2.5 rounded-lg text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-amber-500"
        >
      </div>
        <div>
  <label class="block text-xs font-semibold text-slate-700 mb-1">ज़मीन का विवरण (Road Width, Registry, Nearby Landmark आदि)</label>
  <textarea name="description" rows="3" placeholder="जैसे: 20 फीट का रास्ता, तुरंत रजिस्ट्री, AIIMS रोड के नजदीक..." class="w-full border border-slate-300 p-2.5 rounded-lg text-sm focus:ring-2 focus:ring-amber-500 outline-none"></textarea>
</div>
      <div>
        <label class="block text-xs font-semibold text-slate-700 mb-1">Plot Ki Photo (Upload Karein)</label>
        <input 
          type="file" 
          name="image" 
          accept="image/*" 
          class="w-full border border-slate-300 p-2 rounded-lg text-sm bg-slate-50 text-slate-600 file:mr-3 file:py-1.5 file:px-3 file:rounded-md file:border-0 file:text-xs file:font-semibold file:bg-slate-900 file:text-white hover:file:bg-slate-800 cursor-pointer"
        >
      </div>
      
      <button 
        type="submit" 
        class="w-full bg-slate-900 hover:bg-slate-800 text-white py-2.5 rounded-lg text-sm font-semibold transition mt-2 shadow-sm"
      >
        Publish Land
      </button>

      <div class="text-center mt-3">
        <a href="/" class="text-xs text-slate-500 hover:text-slate-800 underline">← Cancel & Back to Home</a>
      </div>
    </form>
  </div>

</body>
</html>