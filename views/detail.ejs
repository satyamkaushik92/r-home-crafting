<!DOCTYPE html>
<html lang="hi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= land.title %> | r-home crafting</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-100 text-slate-800 antialiased min-h-screen">

  <!-- Navbar -->
  <nav class="bg-slate-900 text-white p-4 sticky top-0 z-50 shadow">
    <div class="max-w-4xl mx-auto flex justify-between items-center">
      <a href="/" class="font-bold text-amber-400 text-sm hover:underline">← वापस सभी प्लॉट्स देखें</a>
      <span class="text-xs text-slate-400 font-semibold">r-home crafting</span>
    </div>
  </nav>

  <!-- Detail Container -->
  <main class="max-w-4xl mx-auto p-4 py-8">
    <div class="bg-white rounded-3xl overflow-hidden shadow-sm border border-slate-200">
      
      <!-- Property Photo -->
      <div class="w-full h-72 sm:h-96 bg-slate-200">
        <img 
          src="<%= land.image %>" 
          alt="<%= land.title %>"
          class="w-full h-full object-cover"
          onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1500382017468-9049fed747ef?auto=format&fit=crop&w=800&q=80';"
        >
      </div>

      <!-- Content -->
      <div class="p-6 sm:p-8 space-y-6">
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2 border-b pb-4">
          <div>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 capitalize"><%= land.title %></h1>
            <p class="text-slate-500 text-sm mt-1 flex items-center gap-1">📍 <%= land.location %></p>
          </div>
          <div class="text-2xl font-black text-amber-600">
            ₹<%= Number(land.price).toLocaleString('en-IN') %>
          </div>
        </div>

        <div class="bg-slate-50 p-4 rounded-xl border border-slate-100 flex items-center justify-between">
          <span class="text-sm font-semibold text-slate-600">प्लॉट का कुल क्षेत्रफल / साइज:</span>
          <span class="text-base font-bold text-slate-900"><%= land.size %></span>
        </div>

        <div>
          <h3 class="font-bold text-slate-900 text-base mb-2">ज़मीन का पूरा विवरण:</h3>
          <p class="text-slate-700 text-sm leading-relaxed whitespace-pre-line bg-slate-50 p-4 rounded-xl border border-slate-100">
            <%= land.description %>
          </p>
        </div>

        <!-- WhatsApp Button -->
        <div class="pt-4">
          <a 
            href="https://wa.me/<%= land.whatsapp %>?text=नमस्ते,%20मैं%20इस%20प्लॉट%20को%20खरीदने/जानकारी%20के%20लिए%20इच्छुक%20हूँ:%20<%= encodeURIComponent(land.title) %>%20लोकेशन:%20<%= encodeURIComponent(land.location) %>"
            target="_blank"
            class="w-full flex items-center justify-center gap-2 bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-3.5 rounded-2xl text-base transition shadow-md"
          >
            <span>💬 सीधे WhatsApp पर मालिक से संपर्क करें</span>
          </a>
        </div>

      </div>

    </div>
  </main>

</body>
</html>