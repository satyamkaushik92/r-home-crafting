<!DOCTYPE html>
<html lang="hi">
<head>
  <meta charset="UTF-8">
  <title>Setup Admin | r-home crafting</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-100 flex items-center justify-center min-h-screen p-4">
  <div class="bg-white p-6 rounded-2xl shadow-md w-full max-w-sm border border-slate-200">
    <h2 class="text-xl font-bold text-slate-900 text-center mb-1">Admin ID बनाएं</h2>
    <p class="text-xs text-slate-500 text-center mb-4">यह सिर्फ पहली बार एक बार सेट होगा</p>

    <form action="/setup-admin" method="POST" class="space-y-4">
      <div>
        <label class="block text-xs font-semibold text-slate-700 mb-1">अपना Email डालें</label>
        <input type="email" name="email" required class="w-full border border-slate-300 p-2.5 rounded-lg text-sm focus:ring-2 focus:ring-amber-500 outline-none">
      </div>
      <div>
        <label class="block text-xs font-semibold text-slate-700 mb-1">Password बनाएं</label>
        <input type="password" name="password" required class="w-full border border-slate-300 p-2.5 rounded-lg text-sm focus:ring-2 focus:ring-amber-500 outline-none">
      </div>
      <button type="submit" class="w-full bg-amber-500 hover:bg-amber-600 text-slate-950 font-bold py-2.5 rounded-lg text-sm transition">
        Admin Create करें
      </button>
    </form>
  </div>
</body>
</html>